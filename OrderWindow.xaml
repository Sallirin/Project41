<Window x:Class="Сытник41.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Сытник41"
        mc:Ignorable="d"
        Title="OrderWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"></ColumnDefinition>
            <ColumnDefinition Width="auto"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Дата формирования заказа" Grid.Row="0" Grid.Column="0"></TextBlock>
        <TextBox Text="Выбор даты" Grid.Row="0" Grid.Column="1"></TextBox>
        <TextBlock Text="Дата доставки заказа" Grid.Row="1" Grid.Column="0"></TextBlock>
        <TextBox Name="OrderDP" Text="Выбор даты" Grid.Row="1" Grid.Column="1"></TextBox>
        <TextBlock Text="ФИО клиента" Grid.Row="2" Grid.Column="0"></TextBlock>
        <TextBox Name="CLientTB" Grid.Row="2" Grid.Column="1"></TextBox>
        <TextBlock Text="Номер заказа" Grid.Column="0" Grid.Row="3"></TextBlock>
        <TextBox Name="TBOrderID" Grid.Row="3" Grid.Column="1"></TextBox>
        <TextBlock Text="Пункт выдачи" Grid.Row="5" Grid.Column="0"></TextBlock>
        <ComboBox Name="PickupCombo" Grid.Row="5" Grid.Column="1"></ComboBox>
        <Button Name="SaveBtn" Click="SaveBtn_Click" Grid.Row="6" Grid.Column="1" HorizontalAlignment="Center"></Button>
        <ListView Name="ShoeListView" Grid.Row="2" SelectionChanged="ShoeListView_SelectionChanged">
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Добавить заказу" Click="MenuItem_Click"></MenuItem>
                </ContextMenu>
            </ListView.ContextMenu>
        </ListView>
    </Grid>
    
</Window>
